# Copy to .env (local dev only — never commit). On Vercel/Cloudflare,
# set these in the project dashboard instead.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...key
ADMIN_PASSWORD=choose-a-strong-14-plus-character-password
# Optional: separate signing secret for admin session cookies.
# Defaults to ADMIN_PASSWORD when unset.
ADMIN_JWT_SECRET=
NODE_ENV=development
